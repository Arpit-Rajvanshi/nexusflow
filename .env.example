# NexusFlow Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────────
# Runtime Environment
# ──────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=nexusflow_dev  # Change in prod!
POSTGRES_DB=nexusflow

# ──────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                  # Leave empty for local dev
REDIS_DB=0
REDIS_STREAM_MAX_LEN=100000

# ──────────────────────────────────────────────────
# API Gateway
# ──────────────────────────────────────────────────
GATEWAY_PORT=8000
GATEWAY_RATE_LIMIT_RPM=60
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRE_MINUTES=1440          # 24 hours

# ──────────────────────────────────────────────────
# Streaming Gateway
# ──────────────────────────────────────────────────
STREAMING_PORT=8001
STREAMING_MAX_CONNECTIONS=500

# ──────────────────────────────────────────────────
# LLM Configuration
# ──────────────────────────────────────────────────
LLM_PROVIDER=openai              # openai | local

# OpenAI
OPENAI_API_KEY=sk-...            # Required if LLM_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o          # gpt-4o | gpt-4o-mini | gpt-3.5-turbo

# Local LLM (vLLM, Ollama, LM Studio, etc.)
# LLM_PROVIDER=local
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=llama3.1:8b

# ──────────────────────────────────────────────────
# Orchestrator
# ──────────────────────────────────────────────────
ORCHESTRATOR_MAX_CONCURRENT_SUBTASKS=10
ORCHESTRATOR_MAX_RETRIES=3
ORCHESTRATOR_TASK_TIMEOUT_SECONDS=300
ORCHESTRATOR_HEARTBEAT_INTERVAL_SECONDS=30

# ──────────────────────────────────────────────────
# Batching Scheduler
# ──────────────────────────────────────────────────
BATCHING_WINDOW_MS=100
BATCHING_MAX_BATCH_SIZE=20
BATCHING_MIN_BATCH_SIZE=5
