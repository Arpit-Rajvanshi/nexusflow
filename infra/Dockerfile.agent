FROM python:3.12-slim-bookworm

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd -m -u 1001 nexusflow && chown -R nexusflow:nexusflow /app
USER nexusflow

# AGENT_TYPE is set per service in docker-compose.yml
CMD ["python", "-m", "nexusflow.agents.runner", "--agent-type", "${AGENT_TYPE}"]
