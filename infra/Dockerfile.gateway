FROM python:3.12-slim-bookworm

WORKDIR /app

# System deps — minimal. curl is needed for healthchecks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Non-root user for security
RUN useradd -m -u 1001 nexusflow && chown -R nexusflow:nexusflow /app
USER nexusflow

CMD ["uvicorn", "nexusflow.services.gateway.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
